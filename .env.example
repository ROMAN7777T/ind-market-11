# Copy this file to .env and fill in values ONLY on your own computer.
# Never paste these values into chat, screenshots, issues or the app's text boxes.
# The terminal never reads credentials into its database or logs.

# --- Kotak Neo (used only after a future, verified integration; names to be confirmed against official docs) ---
KOTAK_CONSUMER_KEY=<your-value>
KOTAK_CONSUMER_SECRET=<your-value>
KOTAK_MOBILE_NUMBER=<your-value>
KOTAK_UCC=<your-value>
KOTAK_MPIN=<your-value>
KOTAK_TOTP_SECRET=<your-value>

# --- Optional AI assistant (Anthropic). Leave as-is to use rules-based explanations. ---
ANTHROPIC_API_KEY=<your-value>
