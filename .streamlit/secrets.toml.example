# Hosted deployments only. Do NOT commit a real secrets.toml.
# On Streamlit Community Cloud paste these lines into: App settings -> Secrets.
# Use a long password (16+ characters) that you do not use anywhere else.
app_password = "<choose-a-long-unique-password>"

# Optional: enables the AI assistant panel on the hosted copy.
# ANTHROPIC_API_KEY = "<your-value>"
